# Copy this file to .env and adjust as needed. Defaults work with a local Ollama.

# --- App ---
APP_NAME=AI Document Q&A
FRONTEND_URL=http://localhost:8501
DATA_DIR=data

# --- Embeddings provider: ollama | sentence_transformers | openai ---
EMBEDDINGS_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Used only when EMBEDDINGS_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
# Used only when EMBEDDINGS_PROVIDER=openai (any OpenAI-compatible /embeddings API)
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# --- LLM provider: ollama | openai ---
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.1:8b
# Used only when LLM_PROVIDER=openai (also works with any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# CLOUD / FREE DEPLOYMENT EXAMPLE (uncomment + fill to host as a public web app)
# LLM via Groq (free, fast, OpenAI-compatible):
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=gsk_your_groq_key
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
# Embeddings via a free API (Jina shown; Google Gemini's OpenAI endpoint also works):
#   EMBEDDINGS_PROVIDER=openai
#   EMBEDDINGS_API_KEY=jina_your_key
#   EMBEDDINGS_BASE_URL=https://api.jina.ai/v1
#   EMBEDDINGS_MODEL=jina-embeddings-v3

# --- Retrieval / chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
SCORE_THRESHOLD=0.25

# Retrieval strategy: hybrid (BM25 keyword + vector) | vector | keyword
RETRIEVAL_MODE=hybrid
RRF_K=60
CANDIDATE_POOL=20

# --- Limits ---
MAX_UPLOAD_MB=25
REQUEST_TIMEOUT=120
